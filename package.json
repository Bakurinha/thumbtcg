{
  "name": "thumbtcg",
  "version": "0.12.0",
  "private": true,
  "description": "Editor de thumbnails para trading card games",
  "scripts": {
    "test": "node tests/studio.test.cjs && node --test tests/images.test.cjs tests/worker.test.mjs tests/providers.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:advanced": "node tests/advanced.cjs",
    "test:effects": "node tests/effects.cjs",
    "test:themes": "node tests/themes.cjs",
    "test:composition": "node tests/composition.cjs",
    "test:i18n": "node tests/i18n.cjs",
    "test:scenes": "node tests/scenes.cjs && node tests/image-themes.cjs",
    "test:raster": "node tests/raster.cjs",
    "build:filters": "esbuild scripts/raster-filters.entry.js --bundle --minify --format=iife --global-name=ThumbRasterFilters --platform=browser --outfile=vendor/konva/filters-10.9.0.js"
  },
  "devDependencies": {
    "jsdom": "30.1.2",
    "playwright": "1.62.1",
    "konva": "10.9.0",
    "esbuild": "0.28.2"
  }
}
